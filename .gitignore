# ─── Dependencies & package managers ───
node_modules/
.pnp
.pnp.js

# ─── Vercel ───
.vercel/

# ─── Secrets (never commit) ───
.env
.env.local
.env.*.local
*.pem
*.jks
*.keystore

# ─── Local agent / IDE (not app source) ───
.adal/
.agents/
.claude/
.cursor/

# ─── OS ───
.DS_Store
Thumbs.db
Desktop.ini

# ─── Logs & caches ───
*.log
npm-debug.log*
.cache/

# ─── Editors (optional local settings) ───
.idea/
*.swp
*.swo
*~

# ─── Android / Gradle (see also android/.gitignore) ───
android/**/build/
android/.gradle/
*.apk
*.aab
